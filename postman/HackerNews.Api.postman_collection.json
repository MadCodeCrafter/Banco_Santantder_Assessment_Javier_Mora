{
  "info": {
    "name": "Hacker News API - Prueba técnica",
    "description": "Colección básica para validar manualmente la API REST de mejores historias de Hacker News.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7037",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Obtener 5 mejores historias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/best-stories?n=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "best-stories"
          ],
          "query": [
            {
              "key": "n",
              "value": "5"
            }
          ]
        },
        "description": "Devuelve las 5 mejores historias de Hacker News ordenadas por puntuación de forma descendente."
      }
    }
  ]
}
